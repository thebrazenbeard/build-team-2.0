{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BT2_ONE_OPERATIONAL_CHECKPOINT_V1",
  "title": "One Operational Checkpoint V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "role_key",
    "numerical_identity",
    "training_binding",
    "governance_observation",
    "role_map_ref",
    "active_assignments",
    "pending_activations",
    "blockers",
    "service_warden_map",
    "write_authority_observations",
    "provider_objects",
    "verified_effects",
    "historical_constraints",
    "claim_ceilings",
    "next_safe_frontier",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "ONE_OPERATIONAL_CHECKPOINT_V1"},
    "role_key": {"const": "one"},
    "numerical_identity": {"const": 1},
    "training_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_set_digest_sha256", "qualification_id"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "source_set_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "qualification_id": {"type": ["string", "null"]}
      }
    },
    "governance_observation": {"type": "object"},
    "role_map_ref": {"type": ["string", "object"]},
    "active_assignments": {"type": "array"},
    "pending_activations": {"type": "array"},
    "blockers": {"type": "array"},
    "service_warden_map": {"type": "object"},
    "write_authority_observations": {"type": "array"},
    "provider_objects": {"type": "array"},
    "verified_effects": {"type": "array"},
    "historical_constraints": {"type": "array"},
    "claim_ceilings": {"type": "array"},
    "next_safe_frontier": {"type": ["string", "object"]},
    "provenance": {"type": "array"}
  }
}
